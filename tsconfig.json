{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"noImplicitAny": false,
		"incremental": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "@cloudflare/workers-types"],
		"allowImportingTsExtensions": true
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": [
		"node_modules",

		"dist"
	]
}
