# Optional settings for `npm run dev` and `npm run deploy` (stacks/settings.ts lists every one).
# Each is bound to the Worker only when set; in CI, prod reads them from the `production` environment's secrets.

# Turnstile on sign-up and sign-in.
# TURNSTILE_SECRET_KEY=

# The Worker uses Workers AI. Override its chat/draft model, or point it at an OpenAI-compatible API.
# AI_MODEL=@cf/moonshotai/kimi-k2.5
# AI_BASE_URL=
# AI_API_KEY=

# Native push for the mobile apps: APNs keys, or a push relay.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_RELAY_URL=

# Send and receive through Resend or Amazon SES instead of Cloudflare.
# Values entered in Admin > Domains take precedence.
# RESEND_API_KEY=re_...
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Store blobs in Backblaze B2 (all four) or AWS S3 instead of R2.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=
# B2_ENDPOINT=s3.us-west-004.backblazeb2.com
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
