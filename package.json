{
	"name": "lab",
	"version": "0.5.2",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"scripts": {
		"dev": "alchemy dev --stage dev_${USER}_$(basename \"$(git rev-parse --show-toplevel)\")",
		"dev:destroy": "alchemy destroy --stage dev_${USER}_$(basename \"$(git rev-parse --show-toplevel)\")",
		"plan": "alchemy plan --stage live_${USER}_$(basename \"$(git rev-parse --show-toplevel)\")",
		"deploy": "alchemy deploy --stage live_${USER}_$(basename \"$(git rev-parse --show-toplevel)\")",
		"destroy": "alchemy destroy --stage live_${USER}_$(basename \"$(git rev-parse --show-toplevel)\")",
		"ci:plan": "alchemy plan stacks/github.ts --stage ci --profile admin",
		"ci:deploy": "alchemy deploy stacks/github.ts --stage ci --profile admin",
		"dev:node": "node scripts/build-server.mjs && MAILFLARE_RUNTIME=node NODE_ENV=development node dist/server.mjs",
		"build:node": "MAILFLARE_RUNTIME=node vp build && node scripts/build-server.mjs",
		"start:node": "MAILFLARE_RUNTIME=node NODE_ENV=production node dist/server.mjs",
		"push:keys": "node scripts/generate-vapid-keys.mjs",
		"db:seed": "curl -X POST http://localhost:3000/api/seed",
		"lint": "oxlint . --deny-warnings",
		"lint:fix": "oxlint . --fix --deny-warnings",
		"format": "oxfmt . --write",
		"format:check": "oxfmt . --check",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.mjs",
		"test:stack": "bun test ./tests/stack.test.ts",
		"ui:capture": "node scripts/ui-scan/capture.mjs",
		"ui:compare": "node scripts/ui-scan/compare.mjs"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.55",
